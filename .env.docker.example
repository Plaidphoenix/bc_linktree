# Copy to .env.docker. This file contains only non-secret configuration.
COMPOSE_PROJECT_NAME=linkgov
LINKGOV_API_IMAGE=linkgov-api:local
LINKGOV_POSTGRES_IMAGE=postgres:18.4-bookworm

# Local homologation defaults. Production must use HTTPS through a reverse proxy.
LINKGOV_ENVIRONMENT=development
LINKGOV_API_BIND=127.0.0.1
LINKGOV_API_PORT=8787
LINKGOV_APP_BASE_URL=http://localhost:5173
LINKGOV_ADMIN_BASE_URL=http://localhost:5173
LINKGOV_ASSET_BASE_URL=http://localhost:8787/api/assets

POSTGRES_DB=linkgov
POSTGRES_USER=linkgov
POSTGRES_ADMIN_USER=linkgov_admin
DATABASE_POOL_SIZE=10

SIM_API_BASE_URL=https://sim.bc.sc.gov.br/default
SIM_LOGIN_PATH=api/login
SIM_VALIDATE_PATH=api/validar-acesso
SIM_LOGOUT_PATH=api/logout
SIM_LOGIN_CONTENT_TYPE=json
SIM_CLIENT_TYPE=mobile
SIM_SUBJECT_CLAIM=ref_cod_usuario
SIM_REQUEST_TIMEOUT_MS=8000
SIM_SESSION_TTL_SECONDS=3600

LINKGOV_BACKUP_PATH=./local-data/backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_HEALTH_MAX_AGE_MINUTES=1560

LINKGOV_POSTGRES_ADMIN_PASSWORD_FILE=./local-data/secrets/postgres_admin_password
LINKGOV_POSTGRES_APP_PASSWORD_FILE=./local-data/secrets/postgres_app_password
LINKGOV_SIM_ENCRYPTION_KEY_FILE=./local-data/secrets/sim_token_encryption_key
