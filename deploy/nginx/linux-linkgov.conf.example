upstream linkgov_backend {
    server 127.0.0.1:8787;
    keepalive 16;
}

limit_req_zone $binary_remote_addr zone=linkgov_login:10m rate=10r/m;

server {
    listen 80;
    server_name linkgov.invalid;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name linkgov.invalid;

    ssl_certificate /etc/nginx/tls/linkgov-fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/linkgov-private-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:LinkGovTLS:10m;
    ssl_session_timeout 1d;

    client_max_body_size 6m;

    location = /api/auth/login {
        limit_req zone=linkgov_login burst=5 nodelay;
        proxy_pass http://linkgov_backend;
        include /etc/nginx/snippets/linkgov-proxy-headers.conf;
    }

    location / {
        proxy_pass http://linkgov_backend;
        include /etc/nginx/snippets/linkgov-proxy-headers.conf;
    }
}
