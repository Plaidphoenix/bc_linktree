{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linkgov-institutional-api-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "local",
    "AUTH_PROVIDER": "local",
    "APP_BASE_URL": "http://127.0.0.1:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linkgov-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "linkgov-assets-dev"
    }
  ],
  "env": {
    "staging": {
      "name": "linkgov-institutional-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "AUTH_PROVIDER": "access"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "linkgov-db-staging",
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "linkgov-assets-staging"
        }
      ]
    },
    "production": {
      "name": "linkgov-institutional-api",
      "vars": {
        "ENVIRONMENT": "production",
        "AUTH_PROVIDER": "access",
        "APP_BASE_URL": "https://bc-linktree.pages.dev",
        "ADMIN_BASE_URL": "https://linkgov-institutional-api.rodrigogastudillo.workers.dev",
        "ASSET_BASE_URL": "https://linkgov-institutional-api.rodrigogastudillo.workers.dev/api/assets",
        "ACCESS_TEAM_DOMAIN": "https://bc-linktree.cloudflareaccess.com",
        "ACCESS_AUD": "5ee63db43bb47a7da20bc32d3d2902c704125cfed4b6505e1c24d9c15ce54025"
      },
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "linkgov-db-production",
          "database_id": "d1d690dc-5272-4086-8264-70b5ced59adc",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "linktree"
        }
      ]
    }
  }
}
