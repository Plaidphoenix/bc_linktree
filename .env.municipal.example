# Frontend: keep the API same-origin behind the municipal reverse proxy.
VITE_API_BASE_URL=
VITE_AUTH_PROVIDER=sim
VITE_SIM_PASSWORD_RESET_URL=https://sim.example.gov.br/recuperar-senha

# Self-hosted API. Store real values only in /etc/linkgov/linkgov.env on the server.
ENVIRONMENT=production
AUTH_PROVIDER=sim
HOST=127.0.0.1
PORT=8787
APP_BASE_URL=https://links.example.gov.br
ADMIN_BASE_URL=https://links.example.gov.br
ASSET_BASE_URL=https://links.example.gov.br/api/assets
ASSET_STORAGE_PATH=/var/lib/linkgov/assets
DATABASE_URL=postgresql://linkgov:CHANGE_ME@127.0.0.1:5432/linkgov
DATABASE_POOL_SIZE=10
SESSION_COOKIE_NAME=linkgov_session

# Public identity endpoint configuration. Do not place user credentials here.
SIM_API_BASE_URL=https://sim.bc.sc.gov.br/default
SIM_LOGIN_PATH=api/login
SIM_VALIDATE_PATH=api/validar-acesso
SIM_LOGOUT_PATH=api/logout
SIM_LOGIN_CONTENT_TYPE=json
SIM_CLIENT_TYPE=mobile
SIM_SUBJECT_CLAIM=ref_cod_usuario
SIM_REQUEST_TIMEOUT_MS=8000
SIM_SESSION_TTL_SECONDS=3600

# Secret: generate 32 random bytes as base64url and keep it only on the server.
SIM_TOKEN_ENCRYPTION_KEY=CHANGE_ME
